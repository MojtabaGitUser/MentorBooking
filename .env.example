# Local demonstration only. Copy this file to .env to enable header-based identity.
DEMO_AUTH_ENABLED=true
# Optional full PostgreSQL connection string for an existing development database.
DATABASE_URL=
# For an external database, supply its privileged migration connection as well.
MIGRATION_DATABASE_URL=
# Server-side URL used by Next.js inside Compose.
API_BASE_URL=http://api:3001
# Optional shared HMAC key override. Docker generates a local key when empty.
WEBHOOK_SECRET=
# Background worker (US-15): poll interval 250-3600000 ms, batch size 1-1000 per job per tick.
WORKER_POLL_INTERVAL_MS=5000
WORKER_BATCH_SIZE=100
