# Docker Compose defaults work without an .env file.
# Optional full PostgreSQL connection string for an existing development database.
DATABASE_URL=
# For an external database, supply its privileged migration connection as well.
MIGRATION_DATABASE_URL=
# Server-side URL used by Next.js inside Compose.
API_BASE_URL=http://api:3001
# Reserved for the signed payment webhook story.
WEBHOOK_SECRET=
