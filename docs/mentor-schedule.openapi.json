{
  "openapi": "3.1.0",
  "info": {
    "title": "Mentor scheduling API",
    "version": "1.0.0"
  },
  "security": [
    {
      "DemoUser": []
    }
  ],
  "components": {
    "securitySchemes": {
      "DemoUser": {
        "type": "apiKey",
        "in": "header",
        "name": "X-User-Id"
      }
    },
    "schemas": {
      "WeeklyRulePatch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "weekday": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7,
            "example": 1
          },
          "startLocal": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "example": "09:00"
          },
          "endLocal": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "example": "12:00"
          }
        },
        "minProperties": 1
      },
      "WeeklyRuleCreate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "weekday": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7,
            "example": 1
          },
          "startLocal": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "example": "09:00"
          },
          "endLocal": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "example": "12:00"
          }
        },
        "required": [
          "weekday",
          "startLocal",
          "endLocal"
        ]
      },
      "WeeklyRule": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "mentorId": {
            "type": "string",
            "format": "uuid"
          },
          "weekday": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7,
            "example": 1
          },
          "startLocal": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "example": "09:00"
          },
          "endLocal": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "example": "12:00"
          },
          "timezone": {
            "type": "string",
            "example": "Europe/London"
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "BlockoutPatch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "startsAt": {
            "type": "string",
            "example": "2030-10-26T23:30:00+01:00"
          },
          "endsAt": {
            "type": "string",
            "example": "2030-10-28T00:00:00Z"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "example": "Away"
          }
        },
        "minProperties": 1
      },
      "BlockoutCreate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "startsAt": {
            "type": "string",
            "example": "2030-10-26T23:30:00+01:00"
          },
          "endsAt": {
            "type": "string",
            "example": "2030-10-28T00:00:00Z"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "example": "Away"
          }
        },
        "required": [
          "startsAt",
          "endsAt"
        ]
      },
      "Blockout": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "mentorId": {
            "type": "string",
            "format": "uuid"
          },
          "startsAt": {
            "type": "string",
            "example": "2030-10-26T23:30:00+01:00"
          },
          "endsAt": {
            "type": "string",
            "example": "2030-10-28T00:00:00Z"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "example": "Away"
          }
        }
      }
    }
  },
  "paths": {
    "/mentor/availability": {
      "get": {
        "responses": {
          "200": {
            "description": "Ordered mentor schedule",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WeeklyRule"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing identity"
          },
          "403": {
            "description": "Mentor role and ownership required"
          }
        }
      },
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WeeklyRuleCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WeeklyRule"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing identity"
          },
          "403": {
            "description": "Mentor role and ownership required"
          },
          "422": {
            "description": "Invalid scheduling input"
          }
        }
      }
    },
    "/mentor/availability/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "patch": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WeeklyRulePatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WeeklyRule"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing identity"
          },
          "403": {
            "description": "Mentor role and ownership required"
          },
          "404": {
            "description": "Unknown ID"
          },
          "422": {
            "description": "Invalid scheduling input"
          }
        }
      },
      "delete": {
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "401": {
            "description": "Invalid or missing identity"
          },
          "403": {
            "description": "Mentor role and ownership required"
          },
          "404": {
            "description": "Unknown ID"
          }
        }
      }
    },
    "/mentor/blockouts": {
      "get": {
        "responses": {
          "200": {
            "description": "Ordered mentor schedule",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Blockout"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing identity"
          },
          "403": {
            "description": "Mentor role and ownership required"
          }
        }
      },
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BlockoutCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Blockout"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing identity"
          },
          "403": {
            "description": "Mentor role and ownership required"
          },
          "409": {
            "description": "Conflict with booked sessions",
            "content": {
              "application/json": {
                "example": {
                  "code": "BLOCKOUT_CONFLICT",
                  "message": "Blockout overlaps booked sessions.",
                  "sessionIds": [
                    "f43b6fa8-889e-4aac-a8f1-465341c635aa"
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Invalid scheduling input"
          }
        }
      }
    },
    "/mentor/blockouts/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "patch": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BlockoutPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Blockout"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing identity"
          },
          "403": {
            "description": "Mentor role and ownership required"
          },
          "404": {
            "description": "Unknown ID"
          },
          "409": {
            "description": "Conflict with booked sessions",
            "content": {
              "application/json": {
                "example": {
                  "code": "BLOCKOUT_CONFLICT",
                  "message": "Blockout overlaps booked sessions.",
                  "sessionIds": [
                    "f43b6fa8-889e-4aac-a8f1-465341c635aa"
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Invalid scheduling input"
          }
        }
      },
      "delete": {
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "401": {
            "description": "Invalid or missing identity"
          },
          "403": {
            "description": "Mentor role and ownership required"
          },
          "404": {
            "description": "Unknown ID"
          }
        }
      }
    }
  }
}
